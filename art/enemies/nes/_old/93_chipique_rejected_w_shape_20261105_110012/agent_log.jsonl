), width=9, joint='curve')\npen.line([(49, 48), (49, 38), (50, 33), (53, 30), (55, 30), (57, 32), (58, 36)], fill=rgba(G), width=3, joint='curve')\n\n# paddle, behind the rider\npen.line([(33, 16), (38, 35)], fill=rgba(B), width=2)\npoly(im, [(31, 8), (34, 7), (36, 15), (33, 17)], B)\n\n# rider\noval(im, 38, 25, 9, 16, G)\nrect(im, 40, 29, 5, 4, D)\ndot(im, 41, 30, R)\ndot(im, 43, 30, R)\nrect(im, 44, 34, 3, 4, D)\n\n# canoe\npoly(im, [(9, 30), (12, 30), (17, 37), (62, 37), (67, 30), (70, 30), (67, 40), (59, 47), (20, 47), (12, 40)], B)\nrect(im, 40, 41, 12, 1, K)\nrect(im, 44, 37, 7, 1, K)\n\n# black edges where band 1 and band 2 lie over the hull\npen.line([(25, 37), (29, 47)], fill=K + (255,), width=1)\npen.line([(36, 37), (40, 47)], fill=K + (255,), width=1)\npen.line([(55, 37), (58, 47)], fill=K + (255,), width=1)\npen.line([(66, 37), (68, 42)], fill=K + (255,), width=1)\n\n# head to band 1 and on under the keel\npen.line([(14, 9), (18, 7), (22, 7), (26, 9), (28, 13), (29, 18), (29, 30), (31, 38), (34, 45), (38, 51), (42, 54), (45, 53), (47, 48)], fill=rgba(V), width=9, joint='curve')\npen.line([(32, 16), (32, 30), (34, 37), (37, 43)], fill=rgba(D), width=2, joint='curve')\npen.line([(16, 12), (19, 11), (22, 11), (24, 13), (25, 18), (25, 30), (28, 39), (31, 46), (35, 53), (42, 57), (47, 56), (50, 50)], fill=rgba(G), width=3, joint='curve')\n\n# band 2 and tail\npen.line([(56, 26), (60, 30), (61, 38), (63, 46), (66, 51), (70, 53), (73, 50)], fill=rgba(V), width=9, joint='curve')\npen.line([(57, 32), (58, 39), (60, 47), (64, 54), (70, 57), (76, 52)], fill=rgba(G), width=3, joint='curve')\npen.line([(73, 50), (74, 44)], fill=rgba(V), width=8)\npen.line([(74, 44), (74, 36)], fill=rgba(V), width=6)\npen.line([(74, 36), (73, 28)], fill=rgba(V), width=5)\npen.line([(73, 28), (73, 21)], fill=rgba(V), width=4)\npen.line([(73, 21), (75, 15)], fill=rgba(V), width=3)\npen.line([(75, 15), (78, 13)], fill=rgba(V), width=2)\npen.line([(78, 13), (79, 17)], fill=rgba(V), width=1)\npen.line([(77, 50), (77, 44)], fill=rgba(G), width=2)\npen.line([(77, 44), (76, 36)], fill=rgba(G), width=2)\npen.line([(75, 36), (75, 28)], fill=rgba(G), width=1)\n\n# head\npoly(im, [(4, 5), (7, 3), (15, 2), (18, 3), (18, 9), (4, 9)], V)\npoly(im, [(1, 9), (3, 6), (9, 5), (13, 8), (14, 9)], G)\npoly(im, [(3, 10), (14, 10), (17, 12), (14, 14), (6, 13)], G)\nrect(im, 2, 9, 12, 1, K)\nrect(im, 8, 6, 2, 1, K)\n\n# drip\nrect(im, 4, 14, 2, 4, R)\nrect(im, 4, 20, 1, 2, R)\n\nim = outline(im)\nsave(im)\n","userModified":false},"tool_result_meta":[{"id":"toolu_01QochEsGsxeLoy1y4zW34pX","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
